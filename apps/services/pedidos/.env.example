# =============================================================================
# apps/services/pedidos/.env.example
# Copiar a .env en la VM (permisos 600, fuera de git). NUNCA poner aqui valores
# reales: este archivo se versiona.
#
#     cp .env.example .env && chmod 600 .env
# =============================================================================

# --- Base de datos (la misma que el monolito; rol de solo filas) -------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=libreria_db
DB_USER=libreria_app
DB_PASSWORD=
DB_TIMEOUT=5
DB_POOL_MAX=8

# --- Servicio ----------------------------------------------------------------
PEDIDOS_HOST=0.0.0.0
PEDIDOS_PORT=5005

# Secreto de firma de los JWT. EL MISMO VALOR que en apps/services/login/.env
# y en los demas servicios; sin el no arranca. Generar uno asi, UNA vez, y
# copiarlo en todos los .env:
#
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Origenes de las aplicaciones cliente en produccion, separados por comas
# (p. ej. https://libreria.example.com). Vacio = ningun origen cruzado.
CORS_ORIGENES=

LOG_NIVEL=INFO
