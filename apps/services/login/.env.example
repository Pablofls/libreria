# Copia este archivo a .env en la VM y rellena los valores. El .env NO se
# versiona: lleva la contrasena de la base y la clave de firma de las sesiones.
#
#     cp .env.example .env && chmod 600 .env
#
# OJO: cada microservicio tiene su propio .env en su propio directorio. No los
# compartas ni hagas enlaces simbolicos entre ellos: el de catalogo y este
# definen puertos distintos, y el segundo en arrancar moriria con "Address
# already in use".

# --- Base de datos -----------------------------------------------------------
# libreria_app, que solo puede leer y escribir filas. Nunca el dueno del
# esquema: si este servicio tuviera un fallo, el dano maximo serian los datos,
# nunca la estructura.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=libreria_db
DB_USER=libreria_app
DB_PASSWORD=

# --- Servicio ----------------------------------------------------------------
LOGIN_HOST=0.0.0.0
LOGIN_PORT=5000

# Clave con la que se firman las cookies de sesion. SIN ESTO EL SERVICIO NO
# ARRANCA, a proposito: con un valor por omision en un repositorio publico,
# cualquiera podria fabricarse una sesion. Genera una asi y pegala aqui:
#
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Cambiarla invalida todas las sesiones abiertas, que es justo lo que se quiere
# si alguna vez se sospecha que se filtro.
SECRET_KEY=

# A 1 solo cuando el servicio se sirva por HTTPS: marca la cookie como Secure y
# deja de viajar por HTTP. Con HTTP y esto a 1, nadie podria iniciar sesion.
COOKIE_SEGURA=0

# --- Verificacion del correo contra Postfix -----------------------------------
# Postfix escucha solo en loopback; no debe ser alcanzable desde internet.
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_TIMEOUT=8
SMTP_REMITENTE=verificador@localhost

# A 0 para desactivar la sonda (util en desarrollo, sin Postfix delante). Con
# la sonda desactivada, todo correo se registra como no_verificable.
VERIFICAR_CORREO=1

# --- Otros --------------------------------------------------------------------
LOG_NIVEL=INFO
BCRYPT_RONDAS=10
