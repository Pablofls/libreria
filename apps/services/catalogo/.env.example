# Copia este archivo a .env y complétalo EN LA VM. El .env no se versiona
# (.gitignore) y este ejemplo solo documenta los NOMBRES de las variables:
# nunca escribas aquí un valor real, el repositorio es público y el historial
# de git conserva cada versión.
#
#     cp .env.example .env
#
# Los nombres DB_* son los mismos que usa el monolito Node (config/env.js), así
# que un solo .env puede servir a los dos servicios.

# --- Base de datos -----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=libreria_db
DB_USER=libreria_app
DB_PASSWORD=
DB_POOL_MAX=10
DB_TIMEOUT=5

# --- Microservicio -----------------------------------------------------------
# 0.0.0.0 solo si el puerto está protegido por el firewall de la VM. Si delante
# hay un proxy inverso, deja 127.0.0.1.
SOAP_HOST=0.0.0.0
# El enunciado publica este catálogo en el puerto 5001
# (http://host:5001/books?format=json), así que en la VM va SOAP_PORT=5001.
# El default sigue siendo 5000 a propósito: apps/services/soap lee
# esta MISMA variable con default 5001, y si los dos servicios comparten .env
# —o se les deja el default— pelean por el puerto. Dale a cada uno el suyo.
SOAP_PORT=5000
LOG_NIVEL=INFO

# Ruta desde la que el navegador pide la hoja de estilos del XML.
SOAP_HOJA_ESTILOS=/library.css

# --- CORS --------------------------------------------------------------------
# Lista separada por comas. '*' permite clientes de cualquier dominio, que es
# lo que pide el ejercicio. Restríngelo a los orígenes reales en producción.
CORS_ORIGENES=*

# --- Candado de escritura ------------------------------------------------------
# insert/update/delete exigen SIEMPRE uno de los dos:
#
# JWT_SECRET (obligatorio). Debe ser EL MISMO VALOR que JWT_SECRET en el .env
# de apps/services/login: con ese secreto compartido este servicio verifica
# los JWT que login firma en /login, mandados como
# `Authorization: Bearer <token>`. Además del token válido, exige que su
# claim `rol` sea "admin": un JWT válido de un lector se rechaza con 403.
# Sin JWT_SECRET el servicio no arranca. Genera uno así y cópialo en los dos
# .env:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# API_TOKEN (opcional). Vía alterna de servicio a servicio con la cabecera
# X-API-Key, para scripts o pruebas que no pasan por login. Déjalo vacío si no
# la necesitas: el JWT sigue exigiéndose igual. Genera uno con:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
