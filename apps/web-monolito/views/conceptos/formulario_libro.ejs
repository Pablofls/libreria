<%- include('../parciales/cabeza') %>
<main class="container">
  <div class="panel panel--angosto">
    <h1><%= titulo %></h1>
    <p class="libro__autor">Para: <a href="<%= base %>/libros/<%= libro.id %>"><%= libro.titulo %></a></p>
    <%- include('../parciales/errores') %>
    <form method="POST" action="<%= base %>/conceptos/libro/<%= libro.id %>" novalidate>
      <%- include('../parciales/csrf') %>
      <div class="campo">
        <label for="termino">Término <span class="req">*</span></label>
        <input type="text" id="termino" name="termino" maxlength="150" required autofocus
               value="<%= actual ? actual.termino : '' %>">
        <p class="ayuda">Si el término ya existe en el catálogo, se reutiliza; si no, se crea.</p>
      </div>
      <div class="campo">
        <label for="definicion">Definición en este libro <span class="req">*</span></label>
        <textarea id="definicion" name="definicion" rows="4" required><%= actual ? actual.definicion : '' %></textarea>
      </div>
      <div class="rejilla-campos">
        <div class="campo">
          <label for="capitulo">Capítulo</label>
          <input type="text" id="capitulo" name="capitulo" maxlength="80"
                 value="<%= actual ? (actual.capitulo || '') : '' %>">
        </div>
        <div class="campo">
          <label for="pagina">Página</label>
          <input type="number" id="pagina" name="pagina" min="1"
                 value="<%= actual && actual.pagina ? actual.pagina : '' %>">
        </div>
      </div>
      <div class="acciones">
        <button type="submit" class="boton">Guardar</button>
        <a class="boton boton--sutil" href="<%= base %>/libros/<%= libro.id %>">Cancelar</a>
      </div>
    </form>
  </div>
</main>
<%- include('../parciales/pie') %>
