<%- include('../parciales/cabeza') %>
<main class="container">
  <div class="panel panel--angosto">
    <h1><%= titulo %></h1>
    <%- include('../parciales/errores') %>
    <form method="POST" action="<%= accion %>" novalidate autocomplete="off">
      <%- include('../parciales/csrf') %>
      <div class="campo">
        <label for="nombre">Nombre <span class="req">*</span></label>
        <input type="text" id="nombre" name="nombre" maxlength="100" required autofocus
               value="<%= registro ? registro.nombre : '' %>">
      </div>
      <div class="campo">
        <label for="email">Correo <span class="req">*</span></label>
        <input type="email" id="email" name="email" maxlength="150" required
               value="<%= registro ? registro.email : '' %>">
      </div>
      <div class="campo">
        <label for="password">
          Contraseña <% if (registro && registro.id) { %><span class="ayuda-linea">(vacío = no cambiar)</span><% } else { %><span class="req">*</span><% } %>
        </label>
        <input type="password" id="password" name="password" autocomplete="new-password"
               <%= registro && registro.id ? '' : 'required' %>>
        <p class="ayuda">Al menos 8 caracteres, con una letra y un número. Se guarda con bcrypt, nunca en claro.</p>
      </div>
      <div class="campo">
        <label for="rol">Rol</label>
        <select id="rol" name="rol">
          <option value="lector" <%= registro && registro.rol === 'lector' ? 'selected' : '' %>>Lector</option>
          <option value="admin"  <%= registro && registro.rol === 'admin'  ? 'selected' : '' %>>Administrador</option>
        </select>
        <p class="ayuda">Sólo puede existir un Administrador; la base de datos rechaza el segundo.</p>
      </div>
      <label class="casilla">
        <input type="checkbox" name="activo" value="true"
               <%= !registro || registro.activo !== false ? 'checked' : '' %>>
        Cuenta activa (puede iniciar sesión)
      </label>
      <div class="acciones">
        <button type="submit" class="boton">Guardar</button>
        <a class="boton boton--sutil" href="<%= base %>/usuarios">Cancelar</a>
      </div>
    </form>
  </div>
</main>
<%- include('../parciales/pie') %>
