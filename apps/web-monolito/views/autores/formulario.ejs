<%- include('../parciales/cabeza') %>
<main class="container">
  <div class="panel panel--angosto">
    <h1><%= titulo %></h1>
    <%- include('../parciales/errores') %>
    <form method="POST" action="<%= accion %>" novalidate>
      <%- include('../parciales/csrf') %>
      <div class="campo">
        <label for="nombre">Nombre <span class="req">*</span></label>
        <input type="text" id="nombre" name="nombre" maxlength="120" required autofocus
               value="<%= registro ? registro.nombre : '' %>">
      </div>
      <div class="campo">
        <label for="nacionalidad">Nacionalidad</label>
        <input type="text" id="nacionalidad" name="nacionalidad" maxlength="80"
               value="<%= registro ? (registro.nacionalidad || '') : '' %>">
        <p class="ayuda">Nombre + nacionalidad deben formar una combinación única.</p>
      </div>
      <div class="campo">
        <label for="biografia">Biografía</label>
        <textarea id="biografia" name="biografia" rows="4"><%= registro ? (registro.biografia || '') : '' %></textarea>
      </div>
      <div class="acciones">
        <button type="submit" class="boton">Guardar</button>
        <a class="boton boton--sutil" href="<%= base %>/autores">Cancelar</a>
      </div>
    </form>
  </div>
</main>
<%- include('../parciales/pie') %>
