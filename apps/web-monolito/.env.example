# Copia este archivo a .env y complétalo. El .env NO se versiona (.gitignore)
# y NO se publica en ubiquitous.udem.edu.
#
#     cp .env.example .env
#
# Este archivo solo documenta los NOMBRES de las variables. Nunca escribas
# aquí un valor real: el repositorio es público.

# --- Base de datos -----------------------------------------------------------
DB_USER=libreria_app
DB_HOST=127.0.0.1
DB_NAME=libreria_db
DB_PASSWORD=
DB_PORT=5432

# --- Aplicación --------------------------------------------------------------
NODE_ENV=production

# Node escucha SOLO en loopback: a internet lo expone el reverse proxy.
APP_HOST=127.0.0.1
APP_PORT=3000

# Prefijo público bajo el que publica Apache/NGINX. Vacío en desarrollo local.
BASE_PATH=/library

# --- Sesión ------------------------------------------------------------------
# Mínimo 32 caracteres. Genera uno nuevo por entorno con:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# true solo cuando el sitio se sirve por HTTPS.
COOKIE_SECURE=false

# --- Subida de imágenes ------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=2097152
