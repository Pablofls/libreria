[Unit]
Description=Microservicio GPS (WebSockets, puerto 5900)
After=network.target

[Service]
Type=simple
User=pablogcp26
WorkingDirectory=/opt/udem/libreria/gps/microservice
# Un solo worker: las posiciones viven en memoria del proceso. Los hilos atienden los WebSockets.
ExecStart=/opt/udem/libreria/gps/microservice/.venv/bin/gunicorn --workers 1 --threads 100 --bind 0.0.0.0:5900 app:app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
