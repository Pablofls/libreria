# Dependencias
node_modules/

# Secretos. NUNCA se versionan. Ver docs/SECURITY_REVIEW.md
.env
.env.local
.env.*.local
*.pem
*.key

# Imágenes subidas en tiempo de ejecución. Las portadas de prueba sí se
# versionan, pero viven en db/seed_uploads/ y se copian a uploads/ al instalar.
uploads/*
!uploads/.gitkeep

# Logs y temporales
*.log
npm-debug.log*
.DS_Store
*.swp

# Respaldos de base de datos
*.sql.gz
*.dump

# Python (microservicio de services/soap/)
__pycache__/
*.pyc
.venv/
venv/

# Reporte web del Ejercicio 03: index.html, css/ y publicar.sh SÍ se versionan.
# El resto lo genera publicar.sh copiando desde services/library_soap_service/,
# así que versionarlo duplicaría los documentos y acabarían desincronizados.
docs/ejercicio03/wsdl/
docs/ejercicio03/sql/
docs/ejercicio03/docs/
docs/ejercicio03/evidencias/
docs/ejercicio03/descargas/
docs/ejercicio03/img/

# Salida de compilación de los clientes Java
clients/*/out/
