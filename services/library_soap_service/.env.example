# Copia a .env y completa EN LA VM. El .env no se versiona (.gitignore).
# Este archivo documenta solo los NOMBRES: nunca escribas aquí un valor real,
# el repositorio es público y el historial de git conserva cada versión.
#
#     cp .env.example .env

# --- PostgreSQL --------------------------------------------------------------
# libreria_soap es el rol de mínimo privilegio que crea sql/soap_module.sql.
# NO uses postgres, ni libreria_owner, ni libreria_app.
# La contraseña se asigna en la VM con:  \password libreria_soap
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=libreria_db
DB_USER=libreria_soap
DB_PASSWORD=
DB_POOL_MAX=10
DB_TIMEOUT=5

# --- Servicio ----------------------------------------------------------------
# 127.0.0.1 si delante hay un proxy inverso; 0.0.0.0 solo si el puerto está
# protegido por el firewall de la VM y los clientes de escritorio son externos.
SOAP_HOST=0.0.0.0
SOAP_PORT=5001
LOG_NIVEL=INFO
SOAP_MAX_BYTES=262144
SOAP_LIMITE_DEFECTO=50
SOAP_LIMITE_MAXIMO=200

# --- WS-Security (Tarea 1) ---------------------------------------------------
# Secreto compartido del UsernameToken con PasswordDigest. Sólo aquí: no va en
# la base de datos, ni en el WSDL, ni en las evidencias publicadas.
# Genera uno con:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
WSSE_USUARIO=reportes
WSSE_SECRETO=
WSSE_VENTANA_SEGUNDOS=300
