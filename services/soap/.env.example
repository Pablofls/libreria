# Copia este archivo a .env y complétalo EN LA VM. El .env no se versiona
# (.gitignore) y este ejemplo solo documenta los NOMBRES de las variables:
# nunca escribas aquí un valor real, el repositorio es público y el historial
# de git conserva cada versión.
#
#     cp .env.example .env
#
# Los nombres DB_* son los mismos que usa el monolito Node (config/env.js), así
# que un solo .env puede servir a los dos servicios.

# --- Base de datos -----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=libreria_db
DB_USER=libreria_app
DB_PASSWORD=
DB_POOL_MAX=10
DB_TIMEOUT=5

# --- Microservicio -----------------------------------------------------------
# 0.0.0.0 solo si el puerto está protegido por el firewall de la VM. Si delante
# hay un proxy inverso, deja 127.0.0.1.
SOAP_HOST=0.0.0.0
SOAP_PORT=5000
LOG_NIVEL=INFO

# Ruta desde la que el navegador pide la hoja de estilos del XML.
SOAP_HOJA_ESTILOS=/library.css

# --- CORS --------------------------------------------------------------------
# Lista separada por comas. '*' permite clientes de cualquier dominio, que es
# lo que pide el ejercicio. Restríngelo a los orígenes reales en producción.
CORS_ORIGENES=*

# --- Candado de escritura (opcional) -----------------------------------------
# Si se deja vacío, insert/update/delete quedan abiertos a quien alcance el
# puerto. Con un valor, esas rutas exigen la cabecera X-API-Key. Genera uno con:
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
