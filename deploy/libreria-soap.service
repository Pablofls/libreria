# =============================================================================
# deploy/libreria-soap.service
# Unidad de systemd del modulo SOAP de clasificacion Cloud.
#
#     sudo cp deploy/libreria-soap.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now libreria-soap
#     sudo systemctl status libreria-soap
#     journalctl -u libreria-soap -f
#
# Sin esto, `python app.py` muere al cerrar la sesion SSH.
#
# Es un servicio SEPARADO de libreria.service a proposito: son dos aplicaciones
# independientes, en dos puertos, con dos roles de PostgreSQL distintos. Si una
# se cae, la otra sigue. Reiniciar el modulo SOAP no toca al monolito.
# =============================================================================

[Unit]
Description=Modulo SOAP de clasificacion Cloud (Flask + PostgreSQL)
Documentation=file:/opt/udem/libreria/services/library_soap_service/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=pablogcp26
Group=pablogcp26
WorkingDirectory=/opt/udem/libreria/services/library_soap_service

# Gunicorn y no `python app.py`: el servidor de desarrollo de Flask lo dice el
# mismo al arrancar, no esta hecho para servir de verdad.
#
# UN SOLO WORKER, y no es por modestia de recursos. La proteccion contra
# reenvios de WS-Security guarda los nonces ya usados en memoria del proceso
# (soap/security.py). Con dos workers, un sobre rechazado por uno seria aceptado
# por el otro y la prueba N11 dejaria de tener sentido. La concurrencia se
# resuelve con hilos, que comparten esa memoria.
#
# Si algun dia hicieran falta varios workers, primero hay que mover esa cache a
# Redis o a una tabla. Esta anotado como limitacion en la documentacion tecnica.
# ATENCION: ANTES DE HABILITAR ESTE SERVICIO, ETIQUETAR EL ARBOL
#
#     sudo restorecon -Rv /opt/udem/libreria/services/library_soap_service
#
# Sin eso el servicio falla con 203/EXEC y "Permission denied", aunque el
# binario exista y corra a mano. La causa real, leida del registro de auditoria:
#
#     avc: denied { read } ... tclass=lnk_file
#     scontext=system_u:system_r:init_t
#     tcontext=unconfined_u:object_r:user_home_t
#
# Los archivos del repositorio quedaron etiquetados user_home_t —pasa al clonar
# en el directorio personal y mover con `mv`, que conserva las etiquetas— y
# systemd (init_t) no puede ni LEER un enlace simbolico con ese tipo. Fijate en
# tclass=lnk_file: la denegacion es sobre leer el enlace, no sobre ejecutar su
# destino. Por eso no basta con apuntar el ExecStart a un binario del sistema:
# el fallo ocurre un paso antes de resolver el enlace.
#
# restorecon le devuelve a cada archivo el contexto que la politica define para
# su ubicacion real; bajo /opt eso es usr_t, que systemd si puede leer y
# ejecutar. Es idempotente, y hay que repetirlo si se recrea el entorno virtual.
#
# Se invoca el interprete con -m gunicorn en lugar del script .venv/bin/gunicorn
# porque no depende de que el shebang del script de consola siga siendo valido
# si el venv se mueve. El venv sigue activo: Python detecta pyvenv.cfg a partir
# de la ruta desde la que se le invoco.
ExecStart=/opt/udem/libreria/services/library_soap_service/.venv/bin/python3 \
    -m gunicorn \
    --workers 1 \
    --threads 8 \
    --bind 0.0.0.0:5001 \
    --timeout 30 \
    --access-logfile - \
    --error-logfile - \
    app:app

Restart=on-failure
RestartSec=5

# El .env lo lee python-dotenv desde el WorkingDirectory. Debe pertenecer al
# usuario que ejecuta el servicio y tener permisos 600: contiene la contrasena
# de libreria_soap y el secreto de WS-Security.

# --- Endurecimiento -----------------------------------------------------------
# Este servicio no escribe un solo archivo: no sube imagenes ni genera nada en
# disco. Por eso no lleva ningun ReadWritePaths, al contrario que el monolito.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal
SyslogIdentifier=libreria-soap

[Install]
WantedBy=multi-user.target
