# =============================================================================
# deploy/libreria-pedidos.service
# Unidad de systemd del microservicio de pedidos (JSON + JWT, puerto 5005).
#
#     sudo cp deploy/libreria-pedidos.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now libreria-pedidos
#     sudo systemctl status libreria-pedidos
#     journalctl -u libreria-pedidos -f
#
# Mismo patron que libreria-login.service. UN .env POR SERVICIO, en su propio
# directorio (permisos 600, dueno el usuario del servicio): lleva la contrasena
# de libreria_app y JWT_SECRET_KEY, el MISMO valor que en login y en los demas
# servicios. Quien lea esa clave puede fabricarse un token de administrador.
# =============================================================================

[Unit]
Description=Microservicio de pedidos de la Libreria Online (Flask + PostgreSQL + JWT)
Documentation=file:/opt/udem/libreria/apps/services/pedidos/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=pablogcp26
Group=pablogcp26
WorkingDirectory=/opt/udem/libreria/apps/services/pedidos

# ANTES DE HABILITAR: etiquetar el arbol para SELinux (si no, falla con 203/EXEC)
#
#     sudo restorecon -Rv /opt/udem/libreria/apps/services/pedidos
#
# Repetir cada vez que se recree el venv.
#
# Sin estado en memoria: el JWT es autocontenido, asi que se pueden usar varios
# workers. 2 workers x DB_POOL_MAX conexiones por servicio.
ExecStart=/opt/udem/libreria/apps/services/pedidos/.venv/bin/python3 \
    -m gunicorn \
    --workers 2 \
    --threads 8 \
    --bind 0.0.0.0:5005 \
    --timeout 30 \
    --access-logfile - \
    --error-logfile - \
    app:app

Restart=on-failure
RestartSec=5

# --- Endurecimiento (no escribe en disco) -------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal
SyslogIdentifier=libreria-pedidos

[Install]
WantedBy=multi-user.target
