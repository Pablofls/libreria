# =============================================================================
# deploy/libreria.service
# Unidad de systemd: mantiene la aplicación corriendo y la levanta sola tras un
# reinicio de la VM. Sin esto, `node app.js` muere al cerrar la sesión SSH.
#
#     sudo cp deploy/libreria.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now libreria
#     sudo systemctl status libreria
#     journalctl -u libreria -f          # ver los logs en vivo
# =============================================================================

[Unit]
Description=Libreria Online (Node.js + Express + PostgreSQL)
Documentation=file:/opt/udem/libreria/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
# Se ejecuta como el usuario dueño de los archivos, NO como root. Un usuario de
# sistema dedicado (p. ej. `libreria`) sería algo más estricto, pero obligaría a
# hacer `git pull` con sudo y a reasignar permisos en cada actualización. Lo que
# de verdad importa —que el proceso no corra con privilegios— se cumple igual.
# Ajusta User/Group si despliegas con otra cuenta.
User=pablogcp26
Group=pablogcp26
WorkingDirectory=/opt/udem/libreria/apps/web-monolito
ExecStart=/usr/bin/node app.js
Restart=on-failure
RestartSec=5

# El .env lo lee dotenv desde el WorkingDirectory. Debe pertenecer al usuario
# que ejecuta el servicio y tener permisos 600: es el único lugar del sistema
# con credenciales reales.
Environment=NODE_ENV=production

# --- Endurecimiento del servicio ---------------------------------------------
# El proceso corre como usuario sin privilegios y con el sistema de archivos
# en sólo lectura salvo uploads/. Si alguien lograra ejecutar código dentro de
# la aplicación, no podría escribir en /etc ni en el resto del disco.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/opt/udem/libreria/apps/web-monolito/uploads
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

StandardOutput=journal
StandardError=journal
SyslogIdentifier=libreria

[Install]
WantedBy=multi-user.target
